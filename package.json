{
  "name": "normalizer.app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.tsx",
  "module": "src/server.tsx",
  "scripts": {
    "check": "bun run scripts/check.ts",
    "check:graphile-worker": "bun run src/lib/check-graphile-worker.ts",
    "cir-deps": "bun run circular",
    "circular": "madge --circular --extensions ts,tsx src",
    "cloc": "bun x cloc src",
    "db": "bun run db:studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/run-migrations.ts",
    "db:migrate:workspace-events": "bun run src/db/migrate-workspace-events.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "bun run db:migrate",
    "dev": "vault run -- bun run server",
    "dev:migrate": "vault run -- bun run db:migrate",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "format": "bun x sort-package-json && bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "gh": "open https://github.com/crvouga/normalizer.app/actions",
    "kp": "bun x kill-port 8080",
    "s3:up": "bun run src/db/s3-migrations.ts",
    "server": "bun run --watch src/server.tsx",
    "tc": "bun type-check",
    "test": "bun run scripts/run-tests.ts",
    "test-files:pull": "bun run src/test-files/script-pull.ts",
    "test-files:push": "bun run src/test-files/script-push.ts",
    "type-check": "bunx tsc --noEmit --watch",
    "type-check:once": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@headlessui/react": "^2.2.9",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "arctic": "^3.7.0",
    "bun-plugin-tailwind": "^0.0.14",
    "drizzle-orm": "^0.44.7",
    "graphile-worker": "^0.16.6",
    "lru-cache": "^11.2.4",
    "lucide-react": "^0.555.0",
    "minio": "^8.0.6",
    "openai": "^6.10.0",
    "parquetjs": "^0.11.2",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-syntax-highlighter": "^16.1.1",
    "tailwindcss": "^4.1.17",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.30.6",
    "embedded-postgres": "17.10.0-beta.17",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sort-package-json": "^3.5.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/linux-x64"
  ]
}
