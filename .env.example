# Environment variable names only — no real values.
# Local dev: vault run injects these from secret/personal/dev
# Production (Fly): runtime loader reads secret/personal/prd via VAULT_TOKEN
# CI: GitHub Actions OIDC pulls from secret/personal/prd

# Database (shared Postgres; app uses schema normalizer_app)
DATABASE_URL=

# Backblaze B2 (S3-compatible). Either S3_* or B2_S3_* / B2_BUCKET in the store.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
# B2_S3_ENDPOINT=
# B2_S3_ACCESS_KEY_ID=
# B2_S3_SECRET_ACCESS_KEY=
# B2_S3_REGION=
# B2_BUCKET=

# App
NODE_ENV=development
# LOG_LEVEL=info
PORT=8080
SERVER_BASE_URL=http://localhost:8080
OBJECT_STORE_PRESIGNED_URL_SECRET=

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional LLM
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Fly runtime secret loading (set on Fly, not needed locally with vault run)
VAULT_TOKEN=
VAULT_ADDR=https://secret-store.chrisvouga.dev
VAULT_MOUNT=secret
VAULT_PROJECT=personal
VAULT_CONFIG=prd

# CI deploy only (secret/personal/prd)
FLY_API_TOKEN=
