# Environment variable names only — no real values.
# Local dev: vault run injects these from secret/personal/dev
# Production: infra syncs from secret/personal/prd to the origin droplet
# CI: GitHub Actions OIDC pulls from secret/personal/prd

# Database (shared Postgres; app uses schema normalizer_app)
DATABASE_URL=

# Backblaze B2 (S3-compatible). Either S3_* or B2_S3_* / B2_BUCKET in the store.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
# Namespace within the shared bucket (keys become normalizer-app/<S3_KEY_PREFIX>/...)
S3_KEY_PREFIX=
# B2_S3_ENDPOINT=
# B2_S3_ACCESS_KEY_ID=
# B2_S3_SECRET_ACCESS_KEY=
# B2_S3_REGION=
# B2_BUCKET=

# App
NODE_ENV=development
# LOG_LEVEL=info
PORT=8080
SERVER_BASE_URL=http://localhost:8080
OBJECT_STORE_PRESIGNED_URL_SECRET=

# Background worker
# Set to "true" in the web process so it does NOT run jobs in-process. In
# production the worker runs in a separate container (src/worker.tsx).
# Leave unset locally to run the worker in-process for convenience.
# DISABLE_IN_PROCESS_WORKER=true
# Graphile Worker concurrency. Each concurrent normalization job spins up its
# own PGlite (WASM Postgres) instance, so tune to the worker machine's RAM/CPU.
# WORKER_CONCURRENCY=5

# Optional OAuth (vault keys: NORMALIZER_APP_GOOGLE_CLIENT_ID / NORMALIZER_APP_GOOGLE_CLIENT_SECRET)
# Mapped to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET at startup via normalizeEnvAliases()
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NORMALIZER_APP_GOOGLE_CLIENT_ID=
# NORMALIZER_APP_GOOGLE_CLIENT_SECRET=

# Optional LLM
OPENAI_API_KEY=
# Must include /v1 — e.g. https://api.openai.com/v1 (not https://api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional override for the primary model; fallbacks are resolved dynamically from the OpenAI API
# OPENAI_MODEL=gpt-4o-mini

# Production runtime secret loading (synced by infra deploy, or set via VAULT_TOKEN)
VAULT_TOKEN=
VAULT_ADDR=https://vault.chrisvouga.dev
VAULT_MOUNT=secret
VAULT_PROJECT=personal
VAULT_CONFIG=prd

# Turborepo remote cache (self-hosted; secret/personal/dev and secret/personal/prd)
TURBO_API=
TURBO_TOKEN=
TURBO_TEAM=

# CI / infra (secret/personal/prd)
# Cloudflare token for the normalizer.app zone
CLOUDFLARE_API_TOKEN=
# Optional — zone ID is resolved automatically from CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ZONE_ID=
